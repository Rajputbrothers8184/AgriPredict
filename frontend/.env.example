# ---------------------------------------------------------------------------
# AgriPredict Android app — build-time configuration TEMPLATE
#
#   cp .env.example .env
#
# React Native bakes these values in at build time, so a change requires a
# rebuild (Metro reload is not enough for a release APK).
#
# Only NON-SECRET values belong here. Third-party API keys (weather, Google
# Places) live in the backend's .env: the app never holds them, because anything
# embedded in an APK can be extracted.
# ---------------------------------------------------------------------------

# Where the app finds the backend API.
#   * Android emulator: http://10.0.2.2:8000   (10.0.2.2 is the host machine)
#   * Physical device on the same Wi-Fi: http://<your-computer-LAN-IP>:8000
#   * Production: https://api.your-domain.example
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Milliseconds before a request is abandoned. The app shows cached data instead
# of hanging when the network is poor.
API_TIMEOUT_MS=15000

# Log every request/response to the console (development builds only).
API_DEBUG=false

# Default UI language on first launch: en | ur
DEFAULT_LANGUAGE=en

# Default theme on first launch: light | dark | system
DEFAULT_THEME=system
