# ===========================================================================
# AgriPredict — environment configuration TEMPLATE
#
#   cp .env.example .env      then fill in your own local values
#
# .env is git-ignored. Never commit real keys. Never paste keys into chat.
# Every variable below is read by the backend (see backend/app/core/config.py).
# Frontend runtime settings live in frontend/.env.example (React Native needs
# them baked in at build time by react-native-config).
# ===========================================================================

# --- Application ----------------------------------------------------------
APP_NAME=AgriPredict
ENVIRONMENT=development          # development | testing | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security -------------------------------------------------------------
# REQUIRED. Generate a unique value per machine:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The backend refuses to start in production with the placeholder value.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated list of allowed browser origins ("" is fine for native apps)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Database -------------------------------------------------------------
# SQLite is the default so a fresh clone runs with zero setup.
# For a shared/cloud deployment use PostgreSQL, e.g.
#   DATABASE_URL=postgresql+psycopg://agripredict:password@localhost:5432/agripredict
DATABASE_URL=sqlite:///./agripredict.db
DB_ECHO=false

# --- Weather --------------------------------------------------------------
# OpenWeatherMap is the primary provider (free tier). If the key is absent the
# backend falls back to Open-Meteo, which needs no key but has no uptime SLA.
WEATHER_PROVIDER=openweathermap  # openweathermap | open-meteo | mock
OPENWEATHER_API_KEY=
WEATHER_TIMEOUT_SECONDS=10
WEATHER_CACHE_MINUTES=30

# --- Buyer discovery (Google Maps Platform Places API) --------------------
# Billing must be enabled on the Google Cloud project (free monthly credit).
# Without a key the endpoint responds 503 with a documented explanation.
GOOGLE_PLACES_API_KEY=
PLACES_TIMEOUT_SECONDS=10
PLACES_DEFAULT_RADIUS_M=25000
PLACES_MAX_RESULTS=20

# --- Machine-learning prediction service ---------------------------------
# The ML service is deployed separately from the Android app. The backend
# proxies forecast requests to it, and falls back to its own statistical
# baseline when the ML service is offline.
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=30
ML_SERVICE_ENABLED=true
FORECAST_CACHE_MINUTES=60

# --- Reports --------------------------------------------------------------
REPORT_STORAGE_DIR=./generated_reports
REPORT_TTL_MINUTES=60

# --- Seed / demo data -----------------------------------------------------
# Set to true to load the documented sample fixtures on first start.
SEED_DEMO_DATA=false
