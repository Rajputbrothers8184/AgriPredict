# ---------------------------------------------------------------------------
# AgriPredict — repository-wide ignore rules
# Rule of thumb: if it is generated, downloaded, or secret, it does not belong
# in Git. See CONTRIBUTING.md for the full hygiene policy.
# ---------------------------------------------------------------------------

# ---- Secrets / local configuration (NEVER commit) --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
!debug.keystore
secrets/
credentials.json
google-services.json
serviceAccountKey.json

# ---- Operating system noise ----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---- Editors --------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.iml
*.sublime-workspace

# ---- Node / React Native ------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
coverage/
.nyc_output/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo
metro-cache/
.cache/
.tmp/

# ---- Android build output ----------------------------------------------
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/.cxx/
frontend/android/app/release/
*.apk
*.aab
*.ap_
*.dex
captures/
.cxx/

# ---- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
.hypothesis/
*.log

# ---- Databases / local runtime data -----------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
!database/schema/*.sql
backend/instance/

# ---- Machine-learning artefacts ---------------------------------------
# Trained weights and caches are published via GitHub Releases, not commits.
ml/saved_models/*
!ml/saved_models/.gitkeep
!ml/saved_models/README.md
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.joblib
*.pkl
*.h5
*.bin
ml/.torch/
ml/.chronos/
ml/datasets/raw/
ml/datasets/processed/
!ml/datasets/README.md
!ml/datasets/fixtures/
ml/staging/
ml/runs/
wandb/
lightning_logs/

# ---- Reports generated at runtime ------------------------------------
reports/
exports/
*.xlsx
*.pdf
!docs/**/*.pdf

# ---- Misc ------------------------------------------------------------
*.log
tmp/
temp/
